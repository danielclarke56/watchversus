{
  "name": "WatchVsWatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:auto": "node scripts/dev-auto.js",
    "validate": "tsx scripts/validate-integrity.ts",
    "generate-pairs": "tsx scripts/generate-pairs.ts",
    "prebuild": "npm run validate",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "monitor:cwv": "curl https://watchvswatch.com/api/cron/core-web-vitals",
    "monitor:gsc": "curl https://watchvswatch.com/api/cron/gsc-metrics",
    "test:cwv-local": "node -e \"import('./app/api/cron/core-web-vitals/route.ts')\""
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.0",
    "@tailwindcss/typography": "^0.5.19",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.1",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^2.0.0",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "next": "14.2.35",
    "next-mdx-remote": "^6.0.0",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "openai": "^6.29.0",
    "playwright": "^1.58.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
