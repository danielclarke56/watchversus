# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Upstash Redis (reviews, photos, votes)
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Vercel Blob (user photo uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Admin access — set to your Clerk user ID to restrict /admin routes
# CRITICAL: if not set, admin routes are locked to everyone
ADMIN_USER_ID=user_...
